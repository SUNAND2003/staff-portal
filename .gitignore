# Dependencies (installed from package.json at build time and locally)
node_modules/

# Environment variables — NEVER commit secrets (this repository is public).
# backend/.env must stay untracked; backend/.env.example is the safe template.
.env
.env.*
!.env.example

# Build output
frontend/dist
frontend/dist-ssr

# Runtime uploads - written to disk only when the API runs in development
backend/uploads/

# Vercel link / local settings
.vercel/

# Logs
*.log
npm-debug.log*

.vercel
