# Used by `npm run build` (mode=production). Dev uses .env.development instead.
# Frontend: https://hexaportal.vercel.app   Backend: https://staff-portal-tool.onrender.com
#
# A Vercel dashboard variable named VITE_API_URL takes precedence over this file.
# Keep both identical: this value is the fallback that gets baked into the bundle
# if the dashboard variable is ever missing, and it must never point at a dead host.
# vite.config.js fails the production build if the URL is missing or not an /api URL.
VITE_API_URL=https://staff-portal-tool.onrender.com/api
