# ─── MongoDB Connection ───────────────────────────────────────
# In Production (e.g. Render), use MongoDB Atlas (mongodb+srv://):
# MONGO_URI=mongodb+srv://hexabrandingofficial_db_user:<password>@cluster0.sryoymb.mongodb.net/hexahr?authSource=admin&retryWrites=true&w=majority
#
# In Local Development only (when running a local mongod daemon):
MONGO_URI=mongodb://localhost:27017/hexahr

# ─── JWT Authentication ───────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Server Configuration ────────────────────────────────────
PORT=5000
# Set to 'production' on Render
NODE_ENV=development

# ─── Frontend URL (for CORS) ──────────────────────────────────
