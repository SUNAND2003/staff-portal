# ─── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/hexahr
# OR Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hexahr

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Frontend URL (for CORS) ───────────────────────────────
FRONTEND_URL=http://localhost:5173
